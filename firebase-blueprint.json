{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Public and private user profile information.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth unique identifier."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's registered email address."
        },
        "displayName": {
          "type": "string",
          "description": "User's full name or handle.",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp."
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "PropertyAudit": {
      "title": "Property Audit",
      "description": "A saved property area audit report.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique audit identifier."
        },
        "userId": {
          "type": "string",
          "description": "Owner's Firebase UID."
        },
        "type": {
          "type": "string",
          "enum": ["scan", "calculator"]
        },
        "auditName": {
          "type": "string",
          "maxLength": 150
        },
        "builder": { "type": "string", "maxLength": 100 },
        "project": { "type": "string", "maxLength": 100 },
        "timestamp": { "type": "string", "format": "date-time" },
        "usableArea": { "type": "number" },
        "carpetArea": { "type": "number" },
        "builtUpArea": { "type": "number" },
        "superBuiltUpArea": { "type": "number" }
      },
      "required": ["id", "userId", "type", "auditName", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile data."
    },
    "/users/{userId}/audits/{auditId}": {
      "schema": "PropertyAudit",
      "description": "Stores user-specific property audits."
    }
  }
}
