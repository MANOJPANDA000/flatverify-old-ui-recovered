rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.email.size() <= 200 &&
             (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             data.createdAt is string;
    }

    function isValidPropertyAudit(data) {
      return data.keys().hasAll(['id', 'userId', 'type', 'auditName', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.id is string &&
             data.type in ['scan', 'calculator'] &&
             data.auditName is string && data.auditName.size() <= 150 &&
             data.timestamp is string;
    }

    // --- Match Blocks ---
    
    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && 
                    incoming().uid == existing().uid &&
                    incoming().createdAt == existing().createdAt;
    }

    // User Audits (Sub-collection)
    match /users/{userId}/audits/{auditId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(auditId) && isValidPropertyAudit(incoming());
      allow update: if isOwner(userId) && isValidPropertyAudit(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().userId == existing().userId;
      allow delete: if isOwner(userId);
    }
  }
}
